local pkg = "example"
local work = pkg .. "_work"
local dir = build_dir

os.execute("rm -rf " .. work)
os.execute("mkdir -p " .. work .. "/usr/bin")

local bin = io.open(work .. "/usr/bin/example", "w")
bin:write("#!/bin/sh\n")
bin:write("echo hello\n")
bin:close()

os.execute("chmod +x " .. work .. "/usr/bin/example")

local meta = io.open(work .. "/car", "w")
meta:write("version 0.1\n")
meta:close()

os.execute("fakeroot tar -I zstd -cf " .. pkg .. ".tar.zst " .. work)

os.execute("rm -rf " .. work)

local outf = io.open(dir .. "/status_" .. pkg, "w")
outf:write("[" .. pkg .. "] ok: built successfully\n")
outf:close()

local codef = io.open(dir .. "/status_" .. pkg .. "_code", "w")
codef:write("0")
codef:close()
